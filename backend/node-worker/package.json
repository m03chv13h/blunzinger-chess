{
  "name": "blunziger-chess-node-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:bundle": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --external:@grpc/grpc-js --external:@grpc/proto-loader --external:chess.js",
    "start": "node dist/server.mjs",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.0",
    "chess.js": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
}
