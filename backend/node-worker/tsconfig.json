{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@core/*": ["../../src/core/*"],
      "@bot/*": ["../../src/bot/*"],
      "chess.js": ["./node_modules/chess.js"]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*.ts",
    "../../src/core/**/*.ts",
    "../../src/bot/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../../src/core/**/*.test.ts",
    "../../src/bot/**/*.test.ts"
  ]
}
